---
const strengths = [
  {
    title: "Core Expertise",
    subtitle: "Where I add immediate, production-ready value",
    skills: [
      { name: "Bare-Metal & RTOS Internals", desc: "Designing custom scheduler hooks and timeline-based task tables in FreeRTOS. Managing low-level hardware resources with strict memory and temporal boundaries." },
      { name: "Deterministic Audio & DSP Optimization", desc: "Developing real-time audio pipelines. Hand-optimizing expensive loops ." },
      { name: "Interrupt-Driven Architectures", desc: "Refactoring drivers to use non-blocking structures, drastically reducing interrupt latency." },
      { name: "Microcontroller Bring-Up & Interfacing", desc: "Initializing low-end silicon from scratch. Interfacing robustly with higher-level Linux SoCs over low-overhead networks." }
    ]
  },
  {
    title: "Emerging Capabilities",
    subtitle: "Active areas of R&D and rapid development",
    skills: [
      { name: "Cryptography and hardware Security", desc: "Bypassing heavy IP/TLS stacks by constructing micro-ecc (uECC) and EC-PKI authentication handshakes directly over raw MAC addresses." },
      { name: "Edge AI & User-Space Integration", desc: "Compiling and integrating neural-network audio utilities (like Rust-based DeepFilterNet) into Tina Linux based targets." }
    ]
  },
  {
    title: "Engineering Workflow & Preferences",
    subtitle: "My toolset, environmental preferences, and R&D acceleration",
    skills: [
      { name: "Work Environment & Location", desc: "I operate best in professional English-speaking environments. Comfortable with fully remote, hybrid, or on-premises roles where engineering execution and ownership are respected." },
      { name: "Architectural Mapping (Pen & Paper)", desc: "Before writing a single line of code, I map out state machines, memory limits, and hardware timing on paper to ensure structural soundness." },
      { name: "VScode & Reproducible Builds with Nix Flakes", desc: "I lean strongly toward Nix Flakes over traditional Docker for development environments." },
      { name: "Deep Step-by-Step Debugging", desc: "Using Segger J-Link, Ozone, System View, and GDB for precise instruction stepping, task tracing but i still enjoy a small oscilloscope on my desk while maintaining asserts and printf debugging " },
      { name: "Low-Overhead Meetings", desc: "I highly value efficient, action-oriented face-to-face engineering alignments. I prefer targeted discussion over passive, unproductive status meetings." },
      { name: "AI-Assisted Peer Programming", desc: "treating AI as a highly capable peer programmer,Gemini CLI, Claude and Codex are my personal favorites " },
    ]
  }
];
---

<section id="skills" class="py-24 px-4 bg-slate-900/50">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">Engineering Capabilities</h2>
      <p class="text-slate-400 font-mono text-sm">A transparent, impact-focused assessment of my strengths, R&D skills, and daily workflows.</p>
      <div class="h-1 w-20 bg-sky-500 rounded-full mt-4"></div>
    </div>

    <div class="space-y-16">
      {strengths.map((group) => (
        <div>
          <div class="mb-6">
            <h3 class="text-xl font-bold text-white font-mono flex items-center gap-2">
              <span class="text-sky-500">&gt;</span> {group.title}
            </h3>
            <p class="text-xs text-slate-500 font-mono mt-1">{group.subtitle}</p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {group.skills.map((skill) => (
              <div class="p-6 rounded-2xl bg-slate-800/40 border border-slate-700/50 hover:border-sky-500/20 hover:bg-slate-800/60 transition-all duration-300">
                <h4 class="text-base font-bold text-sky-400 font-mono mb-2">{skill.name}</h4>
                <p class="text-sm text-slate-300 leading-relaxed font-sans">{skill.desc}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>