---
interface Props {
  src: string;
  title: string;
  captures: string[];
  header?: string;
  timebase?: string;
  freq?: string;
}

const { 
  src, 
  title, 
  captures, 
  header = "SEGGER SYSTEMVIEW SCOPE", 
  timebase = "1.00 ms/div", 
  freq = "128 MHz" 
} = Astro.props;
---

<div class="relative rounded-2xl border border-sky-500/20 bg-slate-950/80 overflow-hidden shadow-[0_0_30px_rgba(14,165,233,0.05)] my-6 max-w-full">
  <!-- Top Bezel / Calibration Header -->
  <div class="flex justify-between items-center px-4 py-2 bg-slate-900 border-b border-sky-500/10 font-mono text-[10px] text-sky-400/80">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
      <span class="font-bold uppercase tracking-wider">&gt;&gt; {header}</span>
    </div>
    <div class="flex gap-4">
      {timebase && <span>TIMEBASE: {timebase}</span>}
      {freq && <span class="hidden md:inline">FREQ: {freq}</span>}
    </div>
  </div>

  <!-- Scope Display Area -->
  <div class="relative bg-slate-950 p-1 flex items-center justify-center group overflow-hidden">
    <!-- Overlay Grid Pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(14,165,233,0.04)_1px,transparent_1px),linear-gradient(90deg,rgba(14,165,233,0.04)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none z-10"></div>
    
    <!-- Retro CRT Scanline Effect -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(18,24,38,0)_50%,rgba(0,0,0,0.25)_50%)] bg-[size:100%_4px] pointer-events-none z-10"></div>

    <!-- Image with customized CSS filter matrix for perfect color-blending -->
    <img 
      src={src} 
      alt={title} 
      class="w-full h-auto rounded opacity-85 saturate-120 contrast-115 brightness-95 hue-rotate-[185deg] transition-all duration-500 group-hover:scale-[1.02] group-hover:opacity-100 z-0" 
    />

    <!-- Real-Time Cursor Indicator Overlay -->
    <div class="absolute left-1/3 top-0 bottom-0 w-[1px] bg-sky-500/40 border-l border-dashed border-sky-400/20 pointer-events-none z-10 hidden group-hover:block animate-pulse">
      <div class="absolute top-4 left-2 px-1.5 py-0.5 bg-sky-500/80 text-white font-mono text-[8px] rounded">T: +4.25ms (ISR_Latency)</div>
    </div>
  </div>

  <!-- Lower Telemetry Panel -->
  <div class="grid grid-cols-2 md:grid-cols-4 border-t border-sky-500/10 bg-slate-900/50 p-3 font-mono text-[9px] gap-2 text-slate-400">
    {captures.map((cap, i) => (
      <div class="flex flex-col border-r border-sky-500/5 last:border-r-0 px-2">
        <span class="text-sky-500/60 font-bold text-[8px]">CH_{i+1}</span>
        <span class="text-slate-300 font-semibold uppercase truncate">{cap}</span>
      </div>
    ))}
  </div>
</div>