---
import { Code, Globe, Mail, FileText, Phone, MapPin } from '@lucide/astro';
---

<section class="min-h-[85vh] flex flex-col justify-center items-center text-center px-4 relative overflow-hidden">
  <!-- Decorative background elements -->
  <div class="absolute top-1/4 left-1/4 w-64 h-64 bg-sky-500/10 rounded-full blur-3xl -z-10 animate-pulse"></div>
  <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl -z-10 animate-pulse delay-1000"></div>

  <div class="max-w-4xl mx-auto space-y-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-sky-500/30 bg-sky-500/5 text-sky-400 text-sm font-mono mb-4 animate-fade-in">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      Active R&D Engineer &mdash; Available for Senior Opportunities
    </div>
    
    <h1 class="text-4xl md:text-7xl font-bold tracking-tight text-white leading-none">
      Abanoub AbdelMessieh
    </h1>
    <h2 class="text-xl md:text-2xl font-medium text-slate-400 font-mono">
    Embedded Firmware Engineer focused on deterministic RTOS, audio DSP, and secure resource constrained systems
    </h2>

    <div class="flex justify-center items-center gap-2 text-slate-500 font-mono text-xs">
      <MapPin size={14} class="text-sky-400" />
      <span>Turin, Italy &mdash; <span class="text-sky-400/80">Open to Relocation Within EU</span></span>
    </div>
    <div class="flex flex-wrap justify-center gap-4 pt-6">
      <a href="#projects" class="px-8 py-3 bg-sky-600 hover:bg-sky-500 text-white rounded-lg font-medium transition-colors duration-200 shadow-lg shadow-sky-600/10">
        View R&D Projects
      </a>
      <a href="/resume.pdf" class="px-8 py-3 bg-slate-800 hover:bg-slate-700 text-white border border-slate-700/80 rounded-lg font-medium flex items-center gap-2 transition-colors duration-200">
        <FileText size={18} />
        Download Resume
      </a>
      <a href="/academic/" class="px-8 py-3 bg-slate-800 hover:bg-slate-700 text-white border border-slate-700/80 rounded-lg font-medium flex items-center gap-2 transition-colors duration-200">
        <Globe size={18} />
        Bachelor Portfolio
      </a>
    </div>

    <div class="flex flex-wrap justify-center gap-6 pt-8 text-slate-500">
      <a href="https://github.com/abanoubn" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2" title="GitHub">
        <Code size={20} />
        <span class="font-mono text-xs hidden md:inline">GitHub</span>
      </a>
      <a href="https://www.linkedin.com/in/abanoub-abdelmessieh?utm_source=share_via&utm_content=profile&utm_medium=member_android" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors flex items-center gap-2" title="LinkedIn">
        <Globe size={20} />
        <span class="font-mono text-xs hidden md:inline">LinkedIn</span>
      </a>
      <a href="mailto:abanoub.nabil8@gmail.com" class="hover:text-white transition-colors flex items-center gap-2" title="Email">
        <Mail size={20} />
        <span class="font-mono text-xs hidden md:inline">abanoub.nabil8@gmail.com</span>
      </a>
      <a href="tel:+393473239912" class="hover:text-white transition-colors flex items-center gap-2" title="Phone">
        <Phone size={20} />
        <span class="font-mono text-xs hidden md:inline">+39 347 323 9912</span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>